# Required
WIKI_ROOT=/path/to/your/wiki-llm-folder

# Server
PORT=3000
HOST=0.0.0.0

# Auth: name:key[:scope[:role]] entries, comma-separated.
#   scope = comma-separated project names or * (default *)
#   role  = admin | write | read (default write)
# Names starting with "user-" or listed in HUMAN_ACTORS are attributed as human actors (OKF).
API_KEYS="agent-codex:codex-key-xxx,user-luke:luke-key-yyy,admin:admin-key-zzz:*:admin"

# Allow unauthenticated read access (default: true)
PUBLIC_READ=true

# --- Index store -----------------------------------------------------------
# auto (default): postgres when DATABASE_URL is set, otherwise sqlite
DB_BACKEND=auto
# Postgres connection string (pgvector extension required; compose provides it)
DATABASE_URL=
# SQLite fallback file (used when DB_BACKEND=sqlite or no DATABASE_URL)
DB_PATH=

# --- Bundle layout / OKF ---------------------------------------------------
# auto | okf | wikillm
LAYOUT=auto
# Reject non-conforming writes in bundles that declare okf_version
OKF_STRICT=false
# Comma-separated API key names attributed as human:<name> actors
HUMAN_ACTORS=user-luke

# --- Retrieval / LLM (all optional; any OpenAI-compatible endpoint) --------
# Examples: Cerebras https://api.cerebras.ai/v1, Ollama http://host:11434/v1,
# LM Studio http://host:1234/v1, OpenAI https://api.openai.com/v1
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=llama3.1
# Leave empty to run in FTS-only mode (no vector search)
LLM_EMBED_MODEL=
EMBEDDING_DIMS=1536
# Extract question/summary per chunk with the LLM before embedding
LLM_DISTILL=false

# --- Connectors ------------------------------------------------------------
CONNECTOR_POLL_SECONDS=300

# --- Governance ------------------------------------------------------------
# Requests per minute per identity; 0 disables limiting
RATE_LIMIT_RPM=0

# Logging: trace, debug, info, warn, error
LOG_LEVEL=info

# Docker / deployment
# IMAGE=ghcr.io/lukasparke/wikillm-api
# TAG=latest
# WIKI_PATH=./wiki
